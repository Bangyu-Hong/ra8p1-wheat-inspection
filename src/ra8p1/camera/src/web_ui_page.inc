s.length===1?`固定 ${g.positions[s]}mm`:`滑轨 ${g.positions[s]}mm`));for(let p=0;p<g.shots;p++){const x=left+p*cellW,key=`${r+1}-${p+1}-${s+1}`,result=regionResults.get(key),active=Number(lastData.field_row)===r+1&&Number(lastData.field_column)===p+1&&(lastData.slide_position_index===undefined||Number(lastData.slide_position_index)===s+1),fill=result?.status==='failed'?'#f3a0a8':result?'#7fd2a2':active?'#ffe08b':'#eef4d7',stroke=result?.status==='failed'?'#bf4551':result?'#2a9160':active?'#d99b17':'#b8c98c';m.append(svg('rect',{x:x+2,y:y+2,width:cellW-4,height:cellH-4,rx:8,fill,stroke,'stroke-width':active?3:1.2}));m.append(svg('text',{x:x+cellW/2,y:y+18,'text-anchor':'middle',fill:'#6b7760','font-size':9},`#${routeSequence(r,p,s,g)} · Y${p+1}`));m.append(svg('text',{x:x+cellW/2,y:y+38,'text-anchor':'middle',fill:result?'#155d3b':'#7a866f','font-size':result?17:14,'font-weight':800},result?String(result.count):'--'))}}}const carRow=Math.max(0,Math.min(g.rows-1,(Number(lastData.field_row)||1)-1)),carShot=Math.max(0,Math.min(g.shots-1,(Number(lastData.field_column)||1)-1)),carY=top+carRow*groupH+laneH/2,carX=left+carShot*cellW+cellW/2;m.append(svg('rect',{x:carX-14,y:carY-10,width:28,height:20,rx:5,fill:'#f7b42c',stroke:'#8d6411','stroke-width':2}));m.append(svg('circle',{cx:carX-9,cy:carY-11,r:3,fill:'#46544f'}));m.append(svg('circle',{cx:carX+9,cy:carY-11,r:3,fill:'#46544f'}));m.append(svg('circle',{cx:carX-9,cy:carY+11,r:3,fill:'#46544f'}));m.append(svg('circle',{cx:carX+9,cy:carY+11,r:3,fill:'#46544f'}));m.append(svg('line',{x1:carX+14,y1:carY,x2:carX+29,y2:carY,stroke:'#8d6411','stroke-width':2,'marker-end':'url(#arrow)'}));$('plannedregions').textContent=(g.rows*g.shots*g.positions.length)+' 格';$('completedregions').textContent=regionResults.size+' 格';$('maptotal').textContent=[...regionResults.values()].reduce((n,v)=>n+(Number(v.count)||0),0);$('crossshift').textContent=g.cross+' mm';badge('mapstate',regionResults.size?'实拍结果更新中':'规划预览 · 等待运动控制',regionResults.size?'ok':'info')}function permissions(){const motion=!!(caps&CAP_MOTION),slide=!!(caps&CAP_SLIDE),ai=!!(caps&CAP_AI);badge('motioncap',motion?'底盘已接入':'底盘待接入',motion?'ok':'info');badge('slidecap',slide?'滑轨已接入':'滑轨待接入',slide?'ok':'info');$('sendplan').disabled=!control;$('startmission').disabled=!(control&&motion);$('pausemission').disabled=!(control&&motion);$('stopmission').disabled=!(control&&motion);$('infer').disabled=!(control&&ai);$('preview').disabled=!(control&&ai);all('.chassisjog').forEach(b=>b.disabled=!(control&&motion));all('.slidejog').forEach(b=>b.disabled=!(control&&slide))}function recordRegion(x){const row=Number(x.field_row),shot=Number(x.field_column),slide=Number(x.slide_position_index||1),counted=Number(x.counted_frame_count||0);if(row>0&&shot>0&&x.wheat_count>=0&&counted>lastCounted)regionResults.set(`${row}-${shot}-${slide}`,{count:Number(x.wheat_count),status:'done'});lastCounted=Math.max(lastCounted,counted)}function show(d){const x=d.data||d;lastData=x;recordRegion(x);const known=x.wheat_count>=0;$('wheat').textContent=known?x.wheat_count:'--';$('missionwheat').textContent=val(x.mission_wheat_count??0);$('fieldwheat').textContent=val(x.field_wheat_count??0);$('countedframes').textContent=val(x.counted_frame_count??0);$('sample').textContent=known?'当前照片识别完成':'尚无识别结果';$('temp').textContent=x.environment_valid?val(x.temperature_c):'--';$('hum').textContent=x.environment_valid?val(x.humidity_percent):'--';$('light').textContent=x.light_valid?val(x.light_percent):'--';$('envage').textContent='数据年龄 '+val(x.environment_age_ms)+' ms';$('envvalid').textContent=x.environment_valid?'DHT11 数据有效':'DHT11 数据无效或陈旧';$('lightraw').textContent='ADC '+val(x.light_raw)+' / 平均 '+val(x.light_average);badge('datahealth',x.environment_valid&&x.light_valid?'环境数据正常':'部分数据无效',x.environment_valid&&x.light_valid?'ok':'warn');$('ai').textContent=val(x.inference_ms)+' ms';$('aistate').textContent=ais[x.ai_state]||'未知';badge('camera',cam[x.camera_state]||'未知',x.camera_state===2?'ok':x.camera_state===5?'bad':'warn');badge('sd',sd[x.sd_state]||'未知',x.sd_state===2?'ok':x.sd_state===3?'bad':'warn');badge('network',net[x.network_state]||'未知',x.network_state===5?'ok':x.network_state===4?'info':x.network_state===6?'bad':'warn');$('fieldrow').textContent=val(x.field_row);$('fieldcolumn').textContent=val(x.field_column);$('targetpos').textContent=val(x.target_position_mm);$('actualpos').textContent=val(x.actual_position_mm);$('sequence').textContent=val(x.sequence);$('dhtfault').textContent=val(x.dht11_fault_code);$('lightfault').textContent=val(x.light_fault_code);$('faultflags').textContent=val(x.fault_flags);badge('diaghealth',x.fault_flags?'存在故障':'运行正常',x.fault_flags?'warn':'ok');$('updated').textContent='最新遥测 #'+val(x.sequence)+' · '+new Date().toLocaleTimeString();caps=Number(x.capabilities||0);if(d.control!==undefined){control=!!d.control;badge('lease',control?'控制端':'观察端',control?'ok':'info')}permissions();renderMap()}function plan(){const g=geometry(),fixed=number('fixedposition',0,300);return{schema_version:1,rows:g.rows,columns:1,row_pitch_mm:g.cross,cell_pitch_mm:g.interval,capture_interval_mm:g.interval,travel_distance_mm:g.travel,slide_positions_mm:g.positions,slide_position_count:g.positions.length,slide_mode:$('slidemode').value==='scan'?1:0,slide_fixed_position_mm:fixed,slide_scan_distance_mm:$('slidemode').value==='scan'?number('scandistance',10,300):0,slide_shot_interval_mm:$('slidemode').value==='scan'?number('shotgap',10,300):0,settle_ms:number('settle',0,30000),max_speed_mm_s:number('speed',1,3000),move_timeout_ms:number('movetimeout',1000,300000),inference_timeout_ms:number('inferencetimeout',100,120000),route_mode:'serpentine',on_error_policy:$('errorpolicy').value}}function send(type,data={}){if(!ws||ws.readyState!==1){log('网络尚未连接');return}ws.send(JSON.stringify({type,...data}))}function updateSlideFields(){const scan=$('slidemode').value==='scan';$('fixedpositionfield').style.display=scan?'none':'';$('scandistancefield').style.display=scan?'':'none';$('shotgapfield').style.display=scan?'':'none';renderMap()}function save(){try{const p=plan();p.aisle_width_mm=number('aislewidth',100,2000);p.photo_width_mm=number('photowidth',10,5000);localStorage.setItem('ra8p1_mission_draft',JSON.stringify(p));$('planstatus').textContent='草案已保存在当前浏览器，不会写入板卡。';log('已保存巡检参数草案')}catch(e){$('planstatus').textContent=e.message}}function load(){try{const p=JSON.parse(localStorage.getItem('ra8p1_mission_draft'));if(!p)return;$('rows').value=p.rows;$('aislewidth').value=p.aisle_width_mm||350;$('photowidth').value=p.photo_width_mm||300;$('captureinterval').value=p.capture_interval_mm;$('travel').value=p.travel_distance_mm;$('settle').value=p.settle_ms;$('speed').value=p.max_speed_mm_s;$('movetimeout').value=p.move_timeout_ms;$('inferencetimeout').value=p.inference_timeout_ms;$('errorpolicy').value=p.on_error_policy;if(p.slide_mode!==undefined)$('slidemode').value=p.slide_mode?'scan':'fixed';if(p.slide_fixed_position_mm!==undefined)$('fixedposition').value=Math.min(300,Math.max(0,p.slide_fixed_position_mm));if(p.slide_scan_distance_mm)$('scandistance').value=Math.min(300,p.slide_scan_distance_mm);if(p.slide_shot_interval_mm)$('shotgap').value=Math.min(300,p.slide_shot_interval_mm)}catch(_){localStorage.removeItem('ra8p1_mission_draft')}}function jogSlide(dir){const step=number('slidejogdistance',1,100);if(dir!=='slide_stop'){$('slidemode').value='fixed';const now=number('fixedposition',0,300),next=dir==='slide_extend'?Math.min(300,now+step):Math.max(0,now-step);$('fixedposition').value=next;updateSlideFields()}send('motion_command',{action:'jog',direction:dir,distance_mm:dir==='slide_stop'?0:step})}function connect(){clearTimeout(timer);ws=new WebSocket('ws://'+location.host+'/ws');ws.onopen=()=>{badge('conn','终端已连接','ok');log('WebSocket 已连接')};ws.onmessage=e=>{try{const d=JSON.parse(e.data);if(d.type==='state_snapshot'||d.type==='telemetry')show(d);if(d.message)log(d.message);if(d.status)log('板端响应：'+d.status)