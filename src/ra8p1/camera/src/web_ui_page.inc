"<!doctype html><html lang='zh-CN'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>RA8P1 小麦巡检终端</title>"
"<style>:root{color-scheme:light;--bg:#f3f7f2;--paper:#fffef9;--ink:#18352c;--muted:#65776f;--line:#d7e2da;--green:#16845b;--green2:#21a873;--gold:#e6a51d;--blue:#2789b9;--violet:#7a63bd;--coral:#dc6d4e;--bad:#bc4050;--lane:#d9e1df;--field:#eef4d7}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 8% 0,#fff0b9 0,transparent 24%),radial-gradient(circle at 96% 2%,#cfeee0 0,transparent 30%),linear-gradient(180deg,#f8faf5,#edf4ee);font:15px system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--ink)}button,input,select{font:inherit}main{max-width:1320px;margin:auto;padding:18px}.hero{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;padding:24px;background:linear-gradient(125deg,#fffdf4ee,#e6f7edee);border:1px solid #cfe2d3;border-radius:22px;box-shadow:0 14px 38px #315c3420}.eyebrow{font-size:12px;font-weight:800;letter-spacing:1.8px;color:#4d8062}h1{font-size:clamp(26px,5vw,42px);margin:7px 0;color:#164d35}.hero p{margin:0;color:var(--muted)}.topstates,.legend,.actions{display:flex;gap:8px;flex-wrap:wrap}.state{display:inline-flex;align-items:center;gap:6px;padding:7px 11px;border:1px solid var(--line);border-radius:99px;color:var(--muted);background:#f6f8f5}.state.ok{color:#126341;border-color:#98d0ad;background:#e6f7eb}.state.warn{color:#8e6009;border-color:#e5c97d;background:#fff5d7}.state.bad{color:var(--bad);border-color:#e3a7ae;background:#fff0f1}.state.info{color:#21688d;border-color:#9dcadf;background:#edf8fd}.zone{margin-top:16px;padding:17px;border:1px solid var(--line);border-radius:20px;background:#ffffffc7;box-shadow:0 9px 26px #355c3813}.zone.count{border-top:5px solid var(--gold)}.zone.environment{border-top:5px solid var(--green2)}.zone.mapzone{border-top:5px solid var(--coral)}.zone.motion{border-top:5px solid var(--blue)}.zone.slide{border-top:5px solid var(--violet)}.zone.task{border-top:5px solid #d99a28}.zone.diag{border-top:5px solid #9aa99f}.zonehead{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:13px}.zonehead h2{margin:0;font-size:20px}.zonehead p{margin:4px 0 0;color:var(--muted);font-size:13px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:12px}.card{background:linear-gradient(150deg,#fffefb,#f8fcf7);border:1px solid var(--line);border-radius:16px;padding:15px;box-shadow:0 7px 18px #355c3815}.count .card:first-child{background:linear-gradient(145deg,#fff3c8,#fffdfa)}.label{color:var(--muted);font-size:13px}.value{font-size:30px;font-weight:800;margin-top:6px;color:var(--green)}.unit{font-size:15px;font-weight:650;color:var(--muted)}.count .card:first-child .value{color:#bd7911}.environment .card:nth-child(1) .value{color:#d46245}.environment .card:nth-child(2) .value{color:#2e8aad}.environment .card:nth-child(3) .value{color:#ba8711}.kv{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:9px;padding-bottom:8px;border-bottom:1px dashed #d9e3d5}.kv:last-child{border:0;padding-bottom:0}.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:11px}.field{display:grid;gap:5px}.field label{font-size:12px;color:var(--muted)}input,select{width:100%;border:1px solid var(--line);border-radius:10px;padding:10px;background:#fff;color:var(--ink);outline-color:#58a977}button{cursor:pointer;border:1px solid #17663f;border-radius:11px;padding:10px 14px;color:#fff;background:linear-gradient(135deg,#238257,#17663f);box-shadow:0 5px 12px #17663f30;font-weight:680}button.secondary{color:#285342;background:#f4faf4;border-color:#b8d2bd;box-shadow:none}button.blue{background:linear-gradient(135deg,#3d96bd,#256f95);border-color:#256f95}button.violet{background:linear-gradient(135deg,#8b71bf,#654a9b);border-color:#654a9b}button.gold{background:linear-gradient(135deg,#e5aa2d,#b97911);border-color:#b97911}button.danger{background:linear-gradient(135deg,#dd705b,#b7474b);border-color:#b7474b}button:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}.controlgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.padwrap{display:grid;grid-template-columns:auto minmax(130px,1fr);gap:18px;align-items:center}.pad{display:grid;grid-template-columns:repeat(3,58px);grid-template-rows:repeat(3,44px);gap:7px;justify-content:center}.pad button{padding:4px}.railpad{display:grid;grid-template-columns:repeat(3,minmax(72px,1fr));gap:8px}.note{margin:11px 0 0;padding:10px 12px;border-radius:10px;background:#f2f7f2;color:var(--muted);font-size:12px}.maptoolbar{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:9px;margin-bottom:12px}.metric{padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:#fbfdf9}.metric strong{display:block;margin-top:4px;font-size:19px;color:#256a4b}.mapshell{position:relative;overflow:auto;min-height:330px;max-height:650px;border:1px solid #cad8ce;border-radius:16px;background:linear-gradient(#fbfdf7,#f2f7ef);box-shadow:inset 0 0 0 1px #ffffff}.mapshell svg{display:block;min-width:100%}.legend{margin-top:11px;color:var(--muted);font-size:12px}.dot{width:11px;height:11px;border-radius:3px;display:inline-block}.dot.pending{background:#eef4d7;border:1px solid #b8c98c}.dot.active{background:#ffe08b;border:1px solid #d99b17}.dot.done{background:#7fd2a2;border:1px solid #2a9160}.dot.failed{background:#f3a0a8;border:1px solid #bf4551}.dot.lane{background:var(--lane);border:1px solid #a8b5b2}.taskactions{display:grid;grid-template-columns:repeat(5,minmax(130px,1fr));gap:10px}.taskactions button{min-height:52px;font-size:16px}.axisnote{font-weight:700;color:#4d6e61}.log{height:145px;overflow:auto;white-space:pre-wrap;color:#4e695b;background:#f2f7ef;border-radius:10px;padding:10px;font:12px ui-monospace,Consolas,monospace}.footer{margin:20px 2px;color:var(--muted);font-size:12px;text-align:center}@media(max-width:800px){main{padding:10px}.hero{grid-template-columns:1fr;padding:17px}.zone{border-radius:15px;padding:14px}.controlgrid{grid-template-columns:1fr}.maptoolbar{grid-template-columns:repeat(2,minmax(0,1fr))}.taskactions{grid-template-columns:repeat(2,minmax(0,1fr))}.taskactions button:last-child{grid-column:1/-1}.padwrap{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:470px){.cards,.formgrid,.maptoolbar{grid-template-columns:1fr}.value{font-size:26px}.topstates{display:grid}.taskactions{grid-template-columns:1fr}.taskactions button:last-child{grid-column:auto}}</style></head>"
"<body><main><header class='hero'><div><div class='eyebrow'>RA8P1 FIELD INSPECTION</div><h1>智能小麦田间巡检系统</h1><p id='updated'>等待第一份板端数据</p></div><div class='topstates'><span class='state' id='conn'>正在连接</span><span class='state' id='lease'>观察端</span><span class='state axisnote'>左 X+ · 前 Y+</span></div></header>"
"<section class='zone count'><div class='zonehead'><div><h2>小麦识别与整田计数</h2><p>单张照片计数与整片试验田累计分开显示</p></div><span class='state' id='camera'>摄像头未知</span></div><div class='cards'><article class='card'><div class='label'>当前照片麦穗数</div><div class='value' id='wheat'>--</div><div class='label' id='sample'>尚无识别结果</div></article><article class='card'><div class='label'>本次巡检累计</div><div class='value' id='missionwheat'>0</div><div class='label'>已计数照片 <span id='countedframes'>0</span> 张</div></article><article class='card'><div class='label'>整片试验田总计数</div><div class='value' id='fieldwheat'>0</div><div class='label'>以已完成拍摄区域为统计单位</div></article><article class='card'><div class='label'>AI 状态</div><div class='value' id='aistate'>--</div><div class='kv'><span>推理耗时</span><strong id='ai'>-- ms</strong></div></article></div></section>"
"<section class='zone environment'><div class='zonehead'><div><h2>环境检测</h2><p>温度、湿度和光照独立显示，避免数据挤在一起</p></div><span class='state' id='datahealth'>等待数据</span></div><div class='cards'><article class='card'><div class='label'>温度</div><div class='value'><span id='temp'>--</span> <span class='unit'>℃</span></div><div class='label' id='envage'>等待 DHT11</div></article><article class='card'><div class='label'>湿度</div><div class='value'><span id='hum'>--</span> <span class='unit'>%</span></div><div class='label' id='envvalid'>尚无有效数据</div></article><article class='card'><div class='label'>相对光照</div><div class='value'><span id='light'>--</span> <span class='unit'>%</span></div><div class='label' id='lightraw'>ADC --</div></article><article class='card'><div class='label'>设备链路</div><div class='kv'><span>SD 卡</span><span class='state' id='sd'>未知</span></div><div class='kv'><span>局域网</span><span class='state' id='network'>未知</span></div></article></div></section>"
"<section class='zone mapzone'><div class='zonehead'><div><h2>试验田动态拍摄分布地图</h2><p>每个方格代表一个真实拍摄区域，不代表模型内部推理切片</p></div><span class='state info' id='mapstate'>规划预览</span></div><div class='maptoolbar'><div class='metric'>规划拍摄区域<strong id='plannedregions'>--</strong></div><div class='metric'>地图已完成区域<strong id='completedregions'>0</strong></div><div class='metric'>地图区域计数和<strong id='maptotal'>0</strong></div><div class='metric'>预计换道横移<strong id='crossshift'>-- mm</strong></div></div><div class='mapshell'><svg id='fieldmap' role='img' aria-label='试验田拍摄区域与小车蛇形路线'></svg></div><div class='legend'><span><i class='dot lane'></i> 35 cm 小车过道</span><span><i class='dot pending'></i> 待拍摄区域</span><span><i class='dot active'></i> 当前区域</span><span><i class='dot done'></i> 已完成并记录数量</span><span><i class='dot failed'></i> 拍摄或推理失败</span></div><p class='note'>地图横向为 Y 轴：向右表示 Y+ 前进；纵向为 X 轴：向上表示 X+ 左移、向下表示 X- 右移。摄像头和滑轨位于车体右侧，因此拍摄带画在过道下方。车体朝向始终不旋转。</p></section>"
"<section class='zone motion'><div class='zonehead'><div><h2>底盘运动与田间参数</h2><p>麦轮底盘保持车体朝向不变，只做前后移动和左右横移</p></div><span class='state' id='motioncap'>底盘待接入</span></div><div class='controlgrid'><article class='card'><div class='formgrid'><div class='field'><label>巡检过道数（1–100）</label><input id='rows' type='number' min='1' max='100' value='2'></div><div class='field'><label>小车过道宽度 mm</label><input id='aislewidth' type='number' min='100' max='2000' value='350'></div><div class='field'><label>单张照片横向视野 mm</label><input id='photowidth' type='number' min='10' max='5000' value='300'></div><div class='field'><label>每条过道行程 mm</label><input id='travel' type='number' min='10' max='1000000' value='1200'></div><div class='field'><label>沿 Y 轴拍摄间隔 mm</label><input id='captureinterval' type='number' min='10' max='10000' value='300'></div><div class='field'><label>最大速度 mm/s</label><input id='speed' type='number' min='1' max='3000' value='200'></div><div class='field'><label>运动超时 ms</label><input id='movetimeout' type='number' min='1000' max='300000' value='30000'></div></div><p class='note'>换道横移 = 350 mm 过道宽度 + 滑轨机械扫描行程 + 单张照片横向地面视野。照片视野必须在最终安装高度下实测标定，避免漏拍或重复计数。</p></article><article class='card'><div class='label'>小车位置微调</div><div class='padwrap'><div class='pad'><span></span><button class='blue chassisjog' data-dir='forward' disabled>前 Y+</button><span></span><button class='blue chassisjog' data-dir='left' disabled>左 X+</button><button class='danger chassisjog' data-dir='stop' disabled>停止</button><button class='blue chassisjog' data-dir='right' disabled>右 X-</button><span></span><button class='blue chassisjog' data-dir='backward' disabled>后 Y-</button><span></span></div><div class='field'><label>底盘单次微调距离 mm</label><input id='chassisjogdistance' type='number' min='1' max='1000' value='20'></div></div><p class='note'>四向按钮仅用于现场微调，不改变车体朝向；运动固件接入前保持禁用。</p></article></div></section>"
"<section class='zone slide'><div class='zonehead'><div><h2>右侧滑轨与拍摄设置</h2><p>滑轨最大机械行程 300 mm；固定与扫描模式共用同一位置坐标</p></div><span class='state' id='slidecap'>滑轨待接入</span></div><div class='controlgrid'><article class='card'><div class='formgrid'><div class='field'><label>滑轨模式</label><select id='slidemode'><option value='fixed'>固定位置</option><option value='scan' selected>多位置扫描</option></select></div><div class='field' id='fixedpositionfield'><label>固定伸出位置 mm（0–300）</label><input id='fixedposition' type='number' min='0' max='300' value='0'></div><div class='field' id='scandistancefield'><label>扫描总行程 mm（最大 300）</label><input id='scandistance' type='number' min='10' max='300' value='300'></div><div class='field' id='shotgapfield'><label>滑轨拍摄间隔 mm</label><input id='shotgap' type='number' min='10' max='300' value='100'></div><div class='field'><label>机械停稳时间 ms</label><input id='settle' type='number' min='0' max='30000' value='800'></div><div class='field'><label>推理超时 ms</label><input id='inferencetimeout' type='number' min='100' max='120000' value='5000'></div><div class='field'><label>异常处理</label><select id='errorpolicy'><option value='pause'>暂停等待</option><option value='retry_once'>重试一次</option><option value='abort'>终止任务</option></select></div></div></article><article class='card'><div class='label'>滑轨位置微调</div><div class='railpad'><button class='violet slidejog' data-dir='slide_retract' disabled>回收 X+</button><button class='danger slidejog' data-dir='slide_stop' disabled>停止</button><button class='violet slidejog' data-dir='slide_extend' disabled>伸出 X-</button></div><div class='field' style='margin-top:12px'><label>滑轨单次微调距离 mm</label><input id='slidejogdistance' type='number' min='1' max='100' value='10'></div><p class='note'>执行滑轨微调时自动切换到固定模式，并同步更新固定伸出位置；到达 0 mm 或 300 mm 时停止增加。</p></article></div><p class='note' id='planstatus'>严格流程：底盘到位 → 滑轨到位 → 机械停稳 → 拍摄完整画面 → 推理完成 → 把数量写入对应物理区域 → 再前往下一区域。</p></section>"
"<section class='zone task'><div class='zonehead'><div><h2>巡检任务控制</h2><p>这里统一控制底盘、滑轨、拍摄、推理和区域记录</p></div><span class='state info'>MissionPlanV1</span></div><div class='taskactions'><button id='save' class='secondary'>保存本机草案</button><button id='sendplan' class='violet' disabled>发送巡检参数</button><button id='startmission' class='gold' disabled>开始整田巡检</button><button id='pausemission' class='blue' disabled>暂停 / 继续</button><button id='stopmission' class='danger' disabled>终止任务</button></div><div class='actions' style='margin-top:12px'><button id='infer' disabled>单帧识别</button><button id='preview' class='secondary' disabled>恢复实时预览</button></div></section>"
"<section class='zone diag'><div class='zonehead'><div><h2>系统诊断</h2><p>用于联调和故障定位，不参与运动控制</p></div><span class='state' id='diaghealth'>运行中</span></div><div class='cards'><article class='card'><div class='kv'><span>当前过道 / 拍摄点</span><strong><span id='fieldrow'>--</span> / <span id='fieldcolumn'>--</span></strong></div><div class='kv'><span>目标 / 实际位置</span><strong><span id='targetpos'>--</span> / <span id='actualpos'>--</span> mm</strong></div><div class='kv'><span>遥测序号</span><strong id='sequence'>--</strong></div><div class='kv'><span>系统故障标志</span><strong id='faultflags'>--</strong></div></article><article class='card'><div class='kv'><span>DHT11 故障码</span><strong id='dhtfault'>--</strong></div><div class='kv'><span>光敏故障码</span><strong id='lightfault'>--</strong></div><div class='label' style='margin-top:10px'>连接与命令日志</div><div class='log' id='log'></div></article></div></section><div class='footer'>DHT11：约 1 秒一次　·　光敏：约 100 ms 一轮滤波　·　网页遥测：约 250 ms　·　地图方格为规则示意，不按毫米比例缩放</div></main>"
"<script>const $=x=>document.getElementById(x),all=x=>document.querySelectorAll(x),NS='http://www.w3.org/2000/svg';const log=x=>{$('log').textContent=new Date().toLocaleTimeString()+' '+x+'\\n'+$('log').textContent.slice(0,1800)};let ws,timer,control=false,caps=0,lastData={},lastCounted=0;const regionResults=new Map(),CAP_MOTION=32,CAP_SLIDE=64,CAP_AI=128;const val=x=>x===undefined||x===null?'--':x,sd=['服务关闭','初始化 / 写入中','SD 卡正常','无卡 / 等待恢复'],net=['网络离线','正在探测模块','等待 Wi-Fi 凭据','正在连接 Wi-Fi','已联网，等待终端','终端已连接','网络恢复中'],cam=['摄像头关闭','摄像头空闲','实时采集中','正在停止','采集已停止','摄像头故障'],ais=['实时预览','正在冻结画面','AI 推理中','结果保持'];function badge(id,text,kind){const e=$(id);e.textContent=text;e.className='state '+kind}function number(id,min,max){const n=Number($(id).value);if(!Number.isFinite(n)||n<min||n>max)throw Error($(id).previousElementSibling.textContent+' 超出范围');return n}function whole(id,min,max){const n=number(id,min,max);if(!Number.isInteger(n))throw Error($(id).previousElementSibling.textContent+' 必须为整数');return n}function slidePositions(){if($('slidemode').value!=='scan')return[number('fixedposition',0,300)];const distance=number('scandistance',10,300),gap=number('shotgap',10,300),p=[0];for(let v=gap;v<distance&&p.length<31;v+=gap)p.push(v);if(p[p.length-1]!==distance)p.push(distance);return p}function geometry(){const rows=whole('rows',1,100),travel=number('travel',10,1000000),interval=number('captureinterval',10,10000),positions=slidePositions(),shots=Math.max(1,Math.ceil(travel/interval)),aisle=number('aislewidth',100,2000),photo=number('photowidth',10,5000),scan=$('slidemode').value==='scan'?number('scandistance',10,300):0;return{rows,travel,interval,positions,shots,aisle,photo,cross:aisle+photo+scan}}function svg(tag,attrs,text){const e=document.createElementNS(NS,tag);Object.entries(attrs||{}).forEach(([k,v])=>e.setAttribute(k,v));if(text!==undefined)e.textContent=text;return e}function routeSequence(row,shot,slide,g){const orderedShot=row%2===0?shot:g.shots-1-shot;return 